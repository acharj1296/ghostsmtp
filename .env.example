# --- GhostSMTP System Environments ---

# General Setup
NODE_ENV=development
PORT=4000

# MongoDB Configuration
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=admin_password
MONGO_PORT=27017
MONGO_EXPRESS_PORT=8082
MONGODB_URI=mongodb://admin:admin_password@localhost:27017/ghostsmtp?authSource=admin

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Redis Connection URL (for local dev backend running outside Docker)
REDIS_URL=redis://localhost:6379

# Admin Dashboards Port Configuration
REDIS_COMMANDER_PORT=8081
NGINX_PORT=80

# Firebase Settings
FIREBASE_PROJECT_ID=ghostsmtp-prod
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your_client_email
FIREBASE_CLIENT_ID=your_client_id
FIREBASE_CLIENT_X509_CERT_URL=your_cert_url
FIREBASE_DATABASE_URL=your_db_url
