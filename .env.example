# --- GhostSMTP System Environments ---

# General Setup
NODE_ENV=development
PORT=4000

# PostgreSQL Configuration
POSTGRES_USER=ghost_user
POSTGRES_PASSWORD=ghost_password
POSTGRES_DB=ghostsmtp
POSTGRES_PORT=5432
POSTGRES_HOST=db

# Database Connection URL (for local dev backend running outside Docker)
DATABASE_URL=postgresql://ghost_user:ghost_password@localhost:5432/ghostsmtp

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Redis Connection URL (for local dev backend running outside Docker)
REDIS_URL=redis://localhost:6379

# Admin Dashboards Port Configuration
ADMINER_PORT=8080
REDIS_COMMANDER_PORT=8081
NGINX_PORT=80

# Firebase Settings
FIREBASE_PROJECT_ID=ghostsmtp-prod
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your_client_email
