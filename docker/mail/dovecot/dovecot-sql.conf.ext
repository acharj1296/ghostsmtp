# --- GhostSMTP Dovecot PostgreSQL Auth Extension ---

driver = pgsql
connect = host=db dbname=ghostsmtp user=ghost_user password=ghost_password

default_pass_scheme = BCRYPT

# Database Queries for Authentication (multi-tenant ready)
password_query = SELECT email AS user, password FROM smtp_users WHERE email = '%u' AND active = true

user_query = SELECT '/var/mail/' || domain || '/' || local_part AS home, 1000 AS uid, 1000 AS gid FROM smtp_users WHERE email = '%u' AND active = true
