{
  "name": "ghostsmtp-server",
  "version": "1.0.0",
  "description": "GhostSMTP Express API Server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker:email": "node dist/workers/emailWorker.js",
    "start:worker:webhook": "node dist/workers/webhookWorker.js",
    "test:smtp": "ts-node-dev --transpile-only src/tests/smtpAuth.test.ts",
    "test:queue": "ts-node-dev --transpile-only src/tests/queue.test.ts",
    "test:send": "ts-node-dev --transpile-only src/tests/emailSend.test.ts",
    "test:tracking": "ts-node-dev --transpile-only src/tests/deliveryTracking.test.ts",
    "test:bounce": "ts-node-dev --transpile-only src/tests/bounceComplaint.test.ts",
    "test:webhook": "ts-node-dev --transpile-only src/tests/webhook.test.ts",
    "test:smtp-delivery": "ts-node --transpile-only src/tests/smtpDelivery.integration.test.ts"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "bullmq": "^6.0.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.0.0",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "mongoose": "^8.2.3",
    "nodemailer": "^9.0.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^8.0.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
